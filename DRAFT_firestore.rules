rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == role;
    }

    // manager, supervisor, admin roles
    function isAdmin() {
      return hasRole('manager') || hasRole('supervisor') || hasRole('admin');
    }

    function isExpert() {
      return hasRole('expert') || isAdmin();
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 1. Prices collection
    match /prices/{priceId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 2. Weather Alerts
    match /weatherAlerts/{alertId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 3. Service Providers
    match /providers/{providerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 4. Products
    match /products/{productId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (hasRole('company') || isAdmin());
      allow update, delete: if isSignedIn() && (hasRole('company') || isAdmin());
    }

    // 5. Courses
    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 6. Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      // Only the user themselves can create or update their profile, but they cannot escalate their role.
      allow create: if isOwner(userId) && request.resource.data.role in ['farmer', 'student', 'worker', 'company'];
      allow update: if isOwner(userId) && request.resource.data.role == resource.data.role;
      allow delete: if isAdmin();
    }

    // 7. Inquiries
    match /inquiries/{inquiryId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isExpert();
      allow delete: if isAdmin();
    }

    // 8. Service Requests
    match /serviceRequests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (request.auth.uid == resource.data.farmerId || isAdmin());
    }
  }
}
